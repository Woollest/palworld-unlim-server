# Copy this file to config/discord.env and enter your Discord Bot credentials.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional command channel. Defaults to DISCORD_CHANNEL_ID.
DISCORD_COMMAND_CHANNEL_ID=
# Prefix for text commands, for example: !palops status
DISCORD_COMMAND_PREFIX=!palops
DISCORD_CONNECTION_CHANNEL_ID=
DISCORD_CONNECTION_CHANNEL_ALLOW_EVERYONE=false
# Channel used for maintenance announcements. The bot needs View/Send/Embed permissions.
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
# Optional. Defaults to DISCORD_CHANNEL_ID when empty.
DISCORD_ALERT_CHANNEL_ID=
# Administrator-only channel for errors, recoveries, updates, tests and other operational logs.
# Falls back to DISCORD_BACKUP_CHANNEL_ID, then DISCORD_ALERT_CHANNEL_ID.
DISCORD_ADMIN_LOG_CHANNEL_ID=
# Administrator-only channel used for backup success/failure records.
DISCORD_BACKUP_CHANNEL_ID=
