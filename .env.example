# Copy this file to .env before starting.
# Keep the official image tag pinned. Check the official repository before updating it.
PALWORLD_IMAGE=ghcr.io/pocketpairjp/palserver:v1.0.2.101103
PALWORLD_PORT=8211
PALWORLD_REST_PORT=8212
MAX_PLAYERS=8
BACKUP_RETENTION=20
# Delete oldest external ZIP backups when their total size exceeds this value.
BACKUP_MAX_TOTAL_GB=10
# Never reduce external ZIP backups below this count because of the size limit.
BACKUP_MIN_RETENTION=3
STARTUP_TIMEOUT_SECONDS=180
MONITOR_INTERVAL_SECONDS=30
MAINTENANCE_WARNING_SECONDS=60
AUTO_START_DOCKER_TIMEOUT_SECONDS=600
DISK_WARNING_FREE_GB=20
AUTO_BACKUP_INTERVAL_HOURS=6
METRICS_RETENTION_DAYS=30
LOG_COMPRESS_AFTER_DAYS=7
LOG_RETENTION_DAYS=90
