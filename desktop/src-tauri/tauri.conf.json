{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PalOps",
  "version": "0.2.0",
  "identifier": "io.github.woollest.palops",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Woollest",
    "shortDescription": "Palworld Dedicated Server manager",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
